# Copy these values into your system environment before starting the server.
# Never commit real keys to source control.
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
X_CLIENT_ID=your-x-oauth-client-id
X_CLIENT_SECRET=your-x-oauth-client-secret
VK_CLIENT_ID=your-vk-application-id
VK_CLIENT_SECRET=your-vk-application-secret
OAUTH_REDIRECT_BASE=https://your-app-domain.example
# RESEND_API_KEY is only needed outside Replit; Replit uses the connected Resend integration.
RESEND_API_KEY=re_xxxxxxxxx
MAIL_FROM=ARC Wallet <no-reply@your-verified-domain.com>
PORT=5000
ALLOW_DEV_OTP=false
ADMIN_PASSWORD=your-private-admin-password
ADMIN_EMAIL=your-account-email@example.com

# Optional account-specific custody API. Receiving remains unavailable until
# both values are configured and the provider verifies every response.
CUSTODY_API_BASE_URL=https://custody.example
CUSTODY_API_HEALTH_PATH=/health
CUSTODY_API_CAPABILITIES_PATH=/v1/capabilities
CUSTODY_API_ADDRESS_PATH=/v1/deposit-addresses
CUSTODY_API_BALANCE_PATH=/v1/balances
CUSTODY_API_PAYOUT_PATH=/v1/payouts
# Add CUSTODY_API_TOKEN through Replit Secrets. Never commit or paste the token.
#
# API contract:
# GET /health -> {"status":"ok","provider":"Your provider"}
# GET /v1/capabilities -> {"status":"verified","pairs":[{"asset":"ETH","network":"Ethereum Mainnet"}]}
# Only known ARC asset/network pairs are accepted from this verified response.
# POST /v1/deposit-addresses
#   {"customerId":"<ARC user id>","asset":"ETH","network":"Ethereum Mainnet","requestId":"<unique id>"}
#   -> {"status":"verified","customerId":"<same id>","asset":"ETH","network":"Ethereum Mainnet","address":"<unique address>"}
# GET /v1/balances?customerId=...&asset=...&network=...&address=...
#   -> {"status":"verified","customerId":"<same id>","asset":"ETH","network":"Ethereum Mainnet","address":"<same address>","confirmedBalance":"0.25"}
# Every address must be unique per customer/asset/network. The balance response
# must identify the same customer, asset, network, and address; otherwise ARC
# rejects it and keeps receiving/balance display unavailable.
# POST /v1/payouts
#   {"requestId":"<ARC withdrawal request id>","customerId":"<ARC user id>","asset":"ETH","network":"Ethereum Mainnet","amount":"0.25","recipient":"<destination>"}
#   -> {"status":"completed","requestId":"<same id>","customerId":"<same id>","asset":"ETH","network":"Ethereum Mainnet","amount":"0.25","recipient":"<same destination>","transactionReference":"<provider transaction ref>"}
# The payout API must treat requestId as an idempotency key: retries for the
# same id must never send another transfer and must return the original result.
